# Optional values for noninteractive Prabu setup.
# This file is a reference; Prabu does not load env files automatically.
# Store real values in a protected secret manager and export them before setup.

# Telegram bot token from @BotFather.
# Prabu sends this to `zeroclaw config patch -` through stdin; it is not written
# to config.toml or passed as a child process argument.
PRABU_TELEGRAM_BOT_TOKEN=

# Optional model-provider API key for hosted providers.
# Local providers such as Ollama do not need this.
PRABU_PROVIDER_API_KEY=
